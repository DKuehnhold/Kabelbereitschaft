# Abhängigkeiten / Build-Artefakte der App
app/node_modules/
app/.next/
app/out/
app/build/
app/*.tsbuildinfo
app/next-env.d.ts

# Secrets / Umgebung (Beispieldateien bleiben versioniert)
**/.env
**/.env.local
**/.env.*.local

# Automationslaufzeit: Zustandsdateien, Umleitungsprotokolle und Berichte eines
# laufenden Agentenauftrags. Sie sind fluechtig und koennen Auszuege aus
# Fehlermeldungen enthalten; sie gehoeren nicht in die Versionsgeschichte.
# Quellskripte (.claude/automation/run-orchestrator.ps1 und der veraltete
# Weiterleiter run-programmer.ps1), die Agentenprofile (.claude/agents/),
# Rollenregeln und Aufgabenbeschreibungen (.claude/automation/tasks/) bleiben
# ausdruecklich versionierbar.
/.claude/automation/runtime/

# Betriebssystem / Editor
.DS_Store
Thumbs.db

# Obsidian (volatile Arbeitsdateien)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
