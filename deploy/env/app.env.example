# Vorlage fuer deploy/env/app.env - NUR PLATZHALTER, keine echten Werte.
#
# Die echte Datei app.env liegt ausschliesslich auf dem Zielserver und wird
# NICHT versioniert. Rechte restriktiv setzen (chmod 600, Eigentuemer = der
# Benutzer, der den Stack startet).
#
# Fehlt eine Pflichtvariable, bricht der Containerstart mit Exit-Code 78 und
# einer klaren Meldung ab (app/docker/verify-runtime-config.mjs).

# --- Pflicht: interne Plattform (Arbeitspaket B, Auth-Basis) ------------------
# Anmeldung, Sitzungen und Sitzungswiderruf laufen gegen PostgreSQL.
#
# DATABASE_URL: Verbindung der Anwendung. Die Rolle ist NICHT privilegiert -
# kein SUPERUSER, kein BYPASSRLS, kein Eigentum an den Tabellen (ADR-011 / 2.5).
# Der Login erbt die Gruppenrolle app_user (deploy: bootstrap/01_roles.sql).
# DATABASE_URL=postgresql://BENUTZER:PASSWORT@postgres:5432/kabelbereitschaft
#
# AUTH_SECRET: Schluesselmaterial fuer die verschluesselten Sitzungstokens
# (JWE) und fuer die HMAC-Pseudonymisierung der Anmeldemerkmale.
# Ausschliesslich Runtime-Secret, NIEMALS im Image. Erzeugen z. B. mit
#   openssl rand -base64 32
# AUTH_SECRET=

# --- Pflicht: interner Objektspeicher fuer Bilder (MinIO/S3) ------------------
# Alle fuenf Namen sind Pflicht. Die Liste ist mit MINIO_REQUIRED_ENV_KEYS in
# app/src/lib/minio-config.ts deckungsgleich zu halten.
#
# Wie bei den Plattformwerten oben gilt: Pflichtvariablen ohne setzbaren
# Beispielwert bleiben AUSKOMMENTIERT. Wird diese Vorlage unveraendert kopiert,
# stoppt der Container mit Exit-Code 78, statt still mit einer Luecke oder einem
# Platzhalterwert zu starten. minio-config.ts weist erkennbare Platzhalter
# (PLATZHALTER, CHANGE_ME, BEISPIEL, example.invalid, spitze Klammern)
# zusaetzlich zur Laufzeit ab.
#
# S3_ENDPOINT: intern erreichbarer Endpunkt des Objektspeichers, ausschliesslich
# fuer Server-zu-Server-Aufrufe. Der folgende Wert ist ein Compose-interner
# Dienstname im Containernetz - keine echte IT-Adresse - und darf deshalb als
# Beispiel stehen bleiben.
S3_ENDPOINT=http://minio:9000
#
# S3_PUBLIC_BASE_URL: browserseitig erreichbare Basis fuer signierte GET-URLs.
# Verbindliche Regel (fail-closed geprueft in readMinioConfig):
#   - Sie liegt unter DEMSELBEN Origin wie AUTH_URL.
#   - Ausserhalb von Loopback darf sie NICHT denselben Origin wie S3_ENDPOINT
#     haben.
#   - Der interne Reverse-Proxy muss den Bucket-Pfad auf den privaten
#     MinIO-Dienst routen. Path-Style bedeutet: der Pfad einer signierten URL
#     beginnt mit dem Bucketnamen.
# OFFENE ANFORDERUNG AN DIE INTERNE IT: echte Endpunkte, DNS- und Proxydaten
# liegen noch nicht vor. Hier steht deshalb bewusst KEINE Adresse; der Wert wird
# erst gesetzt, wenn die IT Origin und Proxyregel geliefert hat.
# S3_PUBLIC_BASE_URL=
#
# S3_BUCKET: Name des Buckets, in dem die Vorgangsbilder liegen.
S3_BUCKET=incident-images
#
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: Zugangsdaten des Dienstkontos.
# Ausschliesslich Runtime-Secret, NIEMALS im Image.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Optional, mit dokumentiertem Standard:
# S3_REGION: Region-Vorgabe fuer SigV4. MinIO ignoriert sie, SigV4 braucht aber
# einen Wert. Standard us-east-1.
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE: Path-Style-Adressierung ohne Bucket-Subdomains.
# Standard true; nur ein ausdrueckliches "false" schaltet ab.
# S3_FORCE_PATH_STYLE=true

# --- Optional ----------------------------------------------------------------
# Groesse des Verbindungspools und Laufzeitgrenzen der Datenbankverbindung.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Oeffentliche Basis-URL hinter dem internen Reverse-Proxy. Auth.js leitet
# daraus die Cookie-Einstellungen ab (Secure-Praefix bei https).
# AUTH_URL=https://kabelbereitschaft.intern.example.invalid

# Angezeigte Version im Health-Check. Serverseitig gelesen, deshalb zur
# Laufzeit setzbar (kein Neubau notwendig).
APP_VERSION=0.1.0

# Interner Port und Bind-Adresse des Next.js-Servers. Standard 3000 / 0.0.0.0.
# PORT=3000
# HOSTNAME=0.0.0.0

# Maximale Bild-Uploadgroesse in MB (Standard 15). Hinweis: dieser Wert wird
# im Client-Bundle benoetigt und daher zur Buildzeit eingebrannt. Er ist
# umgebungsUNabhaengig - eine Aenderung erfordert einen neuen Build.
# NEXT_PUBLIC_MAX_IMAGE_MB=15

# --- Ausdruecklich NICHT setzen ----------------------------------------------
# Ist eine dieser Variablen gesetzt, verweigert der Container den Start
# (FORBIDDEN in app/docker/verify-runtime-config.mjs).
#
# Die Webanwendung verwendet keinen Service-Role-Key.
# SUPABASE_SERVICE_ROLE_KEY=
#
# Supabase ist abgeloest; eine verbliebene Altvariable ist ein
# Konfigurationsfehler und soll auffallen, statt still ignoriert zu werden.
# Zudem sind NEXT_PUBLIC_*-Werte buildzeitgebunden - zur Laufzeit gesetzt
# erweckten sie einen falschen Eindruck von Wirksamkeit.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
