# Vorlage fuer deploy/env/app.env - NUR PLATZHALTER, keine echten Werte.
#
# Die echte Datei app.env liegt ausschliesslich auf dem Zielserver und wird
# NICHT versioniert. Rechte restriktiv setzen (chmod 600, Eigentuemer = der
# Benutzer, der den Stack startet).
#
# Fehlt eine Pflichtvariable, bricht der Containerstart mit Exit-Code 78 und
# einer klaren Meldung ab (app/docker/verify-runtime-config.mjs).

# --- Pflicht (Stand Arbeitspaket A) ------------------------------------------
# Solange die Anwendung Supabase nutzt, sind diese beiden Werte erforderlich.
# ACHTUNG: NEXT_PUBLIC_* wird von Next.js zur BUILDZEIT in die Client-Bundles
# eingebrannt. Ein Image ist deshalb derzeit umgebungsspezifisch; ein Digest
# kann noch nicht unveraendert von Stage nach Produktion gehoben werden.
# Mit Arbeitspaket B entfallen beide Variablen (siehe ADR-011).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.intern.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=ANON_KEY_PLATZHALTER

# --- Optional ----------------------------------------------------------------
# Angezeigte Version im Health-Check. Serverseitig gelesen, deshalb zur
# Laufzeit setzbar (kein Neubau notwendig).
APP_VERSION=0.1.0

# Interner Port und Bind-Adresse des Next.js-Servers. Standard 3000 / 0.0.0.0.
# PORT=3000
# HOSTNAME=0.0.0.0

# Maximale Bild-Uploadgroesse in MB (Standard 15). Hinweis: dieser Wert wird
# im Client-Bundle benoetigt und daher zur Buildzeit eingebrannt. Er ist
# umgebungsUNabhaengig - eine Aenderung erfordert einen neuen Build.
# NEXT_PUBLIC_MAX_IMAGE_MB=15

# --- Ausdruecklich NICHT setzen ----------------------------------------------
# Die Webanwendung verwendet keinen Service-Role-Key. Ist die Variable
# gesetzt, verweigert der Container den Start.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Ab Arbeitspaket B (heute noch nicht wirksam) ----------------------------
# DATABASE_URL=postgresql://app_user:PASSWORT@postgres:5432/kabelbereitschaft
# AUTH_SECRET=
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=incident-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
