# Vorlage fuer deploy/env/postgres.env - NUR PLATZHALTER, keine echten Werte.
#
# Die echte Datei liegt ausschliesslich auf dem Zielserver, wird NICHT
# versioniert und erhaelt restriktive Rechte (chmod 600).
#
# Stage und Produktion verwenden getrennte Datenbanken bzw. getrennte
# Instanzen mit jeweils EIGENEN Zugangsdaten. Kein gemeinsames Passwort.

POSTGRES_DB=kabelbereitschaft
POSTGRES_USER=kabelbereitschaft_owner
POSTGRES_PASSWORD=BITTE_ERSETZEN_LANG_UND_ZUFAELLIG

# Empfohlen: strikte Authentifizierung fuer neue Instanzen.
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256

# Hinweis zu Arbeitspaket B: die Anwendung verbindet sich NICHT mit dem
# Eigentuemerkonto oben, sondern mit der eingeschraenkten Rolle app_user
# (kein SUPERUSER, kein BYPASSRLS). Deren Zugangsdaten stehen in app.env
# unter DATABASE_URL und werden im Bootstrap angelegt (siehe ADR-011, 2.10).
